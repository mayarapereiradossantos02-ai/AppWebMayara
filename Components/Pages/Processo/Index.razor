@page "/processos"

@rendermode InteractiveServer

@using AppWebMayara.Model
@using AppWebMayara.DAO

@inject ProcessoDAO ProcessoDAO

<PageTitle>Processos</PageTitle>

<h1>Processos - Sistema de Controle de Processos</h1>

<div class="d-flex justify-content-between align-items-center mb-3">

    <h2>Consulta de Processos</h2>

    <a href="/processos/cadastro" class="btn btn-primary">
        + Novo Processo
    </a>

</div>

<table class="table table-striped table-hover">

    <thead>
        <tr>
            <th>ID</th>
            <th>Número</th>
            <th>Interessado</th>
            <th>Assunto</th>
            <th>Situação</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var processo in processos)
        {
            <tr>

                <td>@processo.Id</td>
                <td>@processo.Numero</td>
                <td>@processo.Interessado</td>
                <td>@processo.Assunto</td>
                <td>@processo.Situacao</td>

                <td class="text-end">

                    <div class="btn-group btn-group-sm">

                        <a href="@($"/processos/editar/{processo.Id}")"
                               class="btn btn-light border text-primary"
                               title="Editar">

                            <i class="bi bi-pencil"></i>

                        </a>

                        <a href="@($"/processos/excluir/{processo.Id}")"
                               class="btn btn-light border text-danger"
                               title="Excluir">

                            <i class="bi bi-trash"></i>

                        </a>

                    </div>

                </td>

            </tr>
        }

    </tbody>

</table>

@if (processos.Count == 0)
{
    <div class="alert alert-info">
        Nenhum processo cadastrado.
    </div>
}

@code {
    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        processos = ProcessoDAO.Listar();
    }
}
